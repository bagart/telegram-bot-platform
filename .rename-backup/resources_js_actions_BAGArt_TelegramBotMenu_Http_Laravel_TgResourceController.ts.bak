* @see misc/BAGArt/telegram-bot-menu-module/src/Http/Laravel/TgResourceController.php:52
* @route '/tgapp/api/v1/resources/{domain}'
*/
TgResourceControllerForm.head = (args: { domain: string | number } | [domain: string | number ] | string | number, options?: RouteQueryOptions): RouteFormDefinition<'get'> => ({
    action: TgResourceController.url(args, {
        [options?.mergeQuery ? 'mergeQuery' : 'query']: {
            _method: 'HEAD',
            ...(options?.query ?? options?.mergeQuery ?? {}),
        }
    }),
    method: 'get',
})

TgResourceController.form = TgResourceControllerForm

export default TgResourceController