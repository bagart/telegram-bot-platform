import { queryParams, type RouteQueryOptions, type RouteDefinition, type RouteFormDefinition, applyUrlDefaults } from './../../../../../wayfinder'
/**
* @see \BAGArt\TelegramBotMenu\Http\Laravel\TgResourceController::__invoke
* @see misc/BAGArt/telegram-bot-menu-module/src/Http/Laravel/TgResourceController.php:52
* @route '/tgapp/api/v1/resources/{domain}'
*/
const TgResourceController = (args: { domain: string | number } | [domain: string | number ] | string | number, options?: RouteQueryOptions): RouteDefinition<'get'> => ({
    url: TgResourceController.url(args, options),
    method: 'get',
})

TgResourceController.definition = {
    methods: ["get","head"],
    url: '/tgapp/api/v1/resources/{domain}',
} satisfies RouteDefinition<["get","head"]>

/**
* @see \BAGArt\TelegramBotMenu\Http\Laravel\TgResourceController::__invoke
* @see misc/BAGArt/telegram-bot-menu-module/src/Http/Laravel/TgResourceController.php:52
* @route '/tgapp/api/v1/resources/{domain}'
*/
TgResourceController.url = (args: { domain: string | number } | [domain: string | number ] | string | number, options?: RouteQueryOptions) => {
    if (typeof args === 'string' || typeof args === 'number') {
        args = { domain: args }
    }

    if (Array.isArray(args)) {
        args = {
            domain: args[0],
        }
    }

    args = applyUrlDefaults(args)

    const parsedArgs = {
        domain: args.domain,
    }

    return TgResourceController.definition.url
            .replace('{domain}', parsedArgs.domain.toString())
            .replace(/\/+$/, '') + queryParams(options)
}

