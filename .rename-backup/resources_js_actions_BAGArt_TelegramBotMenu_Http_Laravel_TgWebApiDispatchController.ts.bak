* @route '/tgapp/api/v1/m/{moduleId}/{path?}'
*/
TgWebApiDispatchController.url = (args: { moduleId: string | number, path?: string | number } | [moduleId: string | number, path: string | number ], options?: RouteQueryOptions) => {
    if (Array.isArray(args)) {
        args = {
            moduleId: args[0],
            path: args[1],
        }
    }

    args = applyUrlDefaults(args)

    validateParameters(args, [
        "path",
    ])

    const parsedArgs = {
        moduleId: args.moduleId,
        path: args.path,
    }

    return TgWebApiDispatchController.definition.url
            .replace('{moduleId}', parsedArgs.moduleId.toString())
            .replace('{path?}', parsedArgs.path?.toString() ?? '')
            .replace(/\/+$/, '') + queryParams(options)
}

