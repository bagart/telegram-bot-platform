*/
const TgWebApiDispatchController = (args: { moduleId: string | number, path?: string | number } | [moduleId: string | number, path: string | number ], options?: RouteQueryOptions): RouteDefinition<'get'> => ({
    url: TgWebApiDispatchController.url(args, options),
