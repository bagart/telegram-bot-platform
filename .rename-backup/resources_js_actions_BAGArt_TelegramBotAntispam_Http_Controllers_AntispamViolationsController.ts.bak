/**
* @see \BAGArt\TelegramBotAntispam\Http\Controllers\AntispamViolationsController::action
* @see misc/BAGArt/telegram-bot-antispam-module/src/Http/Controllers/AntispamViolationsController.php:71
* @route '/antispam/violations/{violationId}/action'
*/
export const action = (args: { violationId: string | number } | [violationId: string | number ] | string | number, options?: RouteQueryOptions): RouteDefinition<'post'> => ({
    url: action.url(args, options),
    method: 'post',
})

action.definition = {
    methods: ["post"],
    url: '/antispam/violations/{violationId}/action',
} satisfies RouteDefinition<["post"]>

/**
* @see \BAGArt\TelegramBotAntispam\Http\Controllers\AntispamViolationsController::action
* @see misc/BAGArt/telegram-bot-antispam-module/src/Http/Controllers/AntispamViolationsController.php:71
* @route '/antispam/violations/{violationId}/action'
*/
action.url = (args: { violationId: string | number } | [violationId: string | number ] | string | number, options?: RouteQueryOptions) => {
    if (typeof args === 'string' || typeof args === 'number') {
        args = { violationId: args }
    }

    if (Array.isArray(args)) {
        args = {
            violationId: args[0],
        }
    }

    args = applyUrlDefaults(args)

    const parsedArgs = {
        violationId: args.violationId,
    }

    return action.definition.url
            .replace('{violationId}', parsedArgs.violationId.toString())
            .replace(/\/+$/, '') + queryParams(options)
}

