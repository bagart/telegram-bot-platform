/**
* @see \BAGArt\TelegramBotAntispam\Http\Controllers\AntispamChatsController::updateSettings
* @see misc/BAGArt/telegram-bot-antispam-module/src/Http/Controllers/AntispamChatsController.php:57
* @route '/antispam/chats/{botId}/{chatId}'
*/
export const updateSettings = (args: { botId: string | number, chatId: string | number } | [botId: string | number, chatId: string | number ], options?: RouteQueryOptions): RouteDefinition<'put'> => ({
    url: updateSettings.url(args, options),
    method: 'put',
})

updateSettings.definition = {
    methods: ["put"],
    url: '/antispam/chats/{botId}/{chatId}',
} satisfies RouteDefinition<["put"]>

/**
* @see \BAGArt\TelegramBotAntispam\Http\Controllers\AntispamChatsController::updateSettings
* @see misc/BAGArt/telegram-bot-antispam-module/src/Http/Controllers/AntispamChatsController.php:57
* @route '/antispam/chats/{botId}/{chatId}'
*/
updateSettings.url = (args: { botId: string | number, chatId: string | number } | [botId: string | number, chatId: string | number ], options?: RouteQueryOptions) => {
    if (Array.isArray(args)) {
        args = {
            botId: args[0],
            chatId: args[1],
        }
    }

    args = applyUrlDefaults(args)

    const parsedArgs = {
        botId: args.botId,
        chatId: args.chatId,
    }

    return updateSettings.definition.url
            .replace('{botId}', parsedArgs.botId.toString())
            .replace('{chatId}', parsedArgs.chatId.toString())
            .replace(/\/+$/, '') + queryParams(options)
}

