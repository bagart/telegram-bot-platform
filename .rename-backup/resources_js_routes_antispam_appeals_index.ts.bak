import { queryParams, type RouteQueryOptions, type RouteDefinition, type RouteFormDefinition, applyUrlDefaults } from './../../../wayfinder'
/**
* @see \BAGArt\TelegramBotAntispam\Http\Controllers\AntispamAppealsController::index
* @see misc/BAGArt/telegram-bot-antispam-module/src/Http/Controllers/AntispamAppealsController.php:25
* @route '/antispam/appeals'
*/
export const index = (options?: RouteQueryOptions): RouteDefinition<'get'> => ({
    url: index.url(options),
    method: 'get',
})

index.definition = {
    methods: ["get","head"],
    url: '/antispam/appeals',
} satisfies RouteDefinition<["get","head"]>

/**
* @see \BAGArt\TelegramBotAntispam\Http\Controllers\AntispamAppealsController::index
* @see misc/BAGArt/telegram-bot-antispam-module/src/Http/Controllers/AntispamAppealsController.php:25
* @route '/antispam/appeals'
*/
index.url = (options?: RouteQueryOptions) => {
    return index.definition.url + queryParams(options)
}

/**
* @see \BAGArt\TelegramBotAntispam\Http\Controllers\AntispamAppealsController::index
* @see misc/BAGArt/telegram-bot-antispam-module/src/Http/Controllers/AntispamAppealsController.php:25
* @route '/antispam/appeals'
*/
index.get = (options?: RouteQueryOptions): RouteDefinition<'get'> => ({
    url: index.url(options),
    method: 'get',
})

/**
* @see \BAGArt\TelegramBotAntispam\Http\Controllers\AntispamAppealsController::index
* @see misc/BAGArt/telegram-bot-antispam-module/src/Http/Controllers/AntispamAppealsController.php:25
* @route '/antispam/appeals'
*/
index.head = (options?: RouteQueryOptions): RouteDefinition<'head'> => ({
    url: index.url(options),
    method: 'head',
})

/**
* @see \BAGArt\TelegramBotAntispam\Http\Controllers\AntispamAppealsController::index
* @see misc/BAGArt/telegram-bot-antispam-module/src/Http/Controllers/AntispamAppealsController.php:25
* @route '/antispam/appeals'
*/
const indexForm = (options?: RouteQueryOptions): RouteFormDefinition<'get'> => ({
    action: index.url(options),
    method: 'get',
})

/**
* @see \BAGArt\TelegramBotAntispam\Http\Controllers\AntispamAppealsController::index
* @see misc/BAGArt/telegram-bot-antispam-module/src/Http/Controllers/AntispamAppealsController.php:25
* @route '/antispam/appeals'
*/
indexForm.get = (options?: RouteQueryOptions): RouteFormDefinition<'get'> => ({
    action: index.url(options),
    method: 'get',
})

/**
* @see \BAGArt\TelegramBotAntispam\Http\Controllers\AntispamAppealsController::index
* @see misc/BAGArt/telegram-bot-antispam-module/src/Http/Controllers/AntispamAppealsController.php:25
* @route '/antispam/appeals'
*/
indexForm.head = (options?: RouteQueryOptions): RouteFormDefinition<'get'> => ({
    action: index.url({
        [options?.mergeQuery ? 'mergeQuery' : 'query']: {
            _method: 'HEAD',
            ...(options?.query ?? options?.mergeQuery ?? {}),
        }
    }),
    method: 'get',
})

index.form = indexForm

/**
* @see \BAGArt\TelegramBotAntispam\Http\Controllers\AntispamAppealsController::decide
* @see misc/BAGArt/telegram-bot-antispam-module/src/Http/Controllers/AntispamAppealsController.php:69
* @route '/antispam/appeals/{appeal}/decision'
*/
export const decide = (args: { appeal: string | number } | [appeal: string | number ] | string | number, options?: RouteQueryOptions): RouteDefinition<'post'> => ({
    url: decide.url(args, options),
    method: 'post',
})

decide.definition = {
    methods: ["post"],
    url: '/antispam/appeals/{appeal}/decision',
} satisfies RouteDefinition<["post"]>

/**
* @see \BAGArt\TelegramBotAntispam\Http\Controllers\AntispamAppealsController::decide
* @see misc/BAGArt/telegram-bot-antispam-module/src/Http/Controllers/AntispamAppealsController.php:69
* @route '/antispam/appeals/{appeal}/decision'
*/
decide.url = (args: { appeal: string | number } | [appeal: string | number ] | string | number, options?: RouteQueryOptions) => {
    if (typeof args === 'string' || typeof args === 'number') {
        args = { appeal: args }
    }

    if (Array.isArray(args)) {
        args = {
            appeal: args[0],
        }
    }

    args = applyUrlDefaults(args)

    const parsedArgs = {
        appeal: args.appeal,
    }

    return decide.definition.url
            .replace('{appeal}', parsedArgs.appeal.toString())
            .replace(/\/+$/, '') + queryParams(options)
}

/**
* @see \BAGArt\TelegramBotAntispam\Http\Controllers\AntispamAppealsController::decide
* @see misc/BAGArt/telegram-bot-antispam-module/src/Http/Controllers/AntispamAppealsController.php:69
* @route '/antispam/appeals/{appeal}/decision'
*/
decide.post = (args: { appeal: string | number } | [appeal: string | number ] | string | number, options?: RouteQueryOptions): RouteDefinition<'post'> => ({
    url: decide.url(args, options),
    method: 'post',
})

/**
* @see \BAGArt\TelegramBotAntispam\Http\Controllers\AntispamAppealsController::decide
* @see misc/BAGArt/telegram-bot-antispam-module/src/Http/Controllers/AntispamAppealsController.php:69
* @route '/antispam/appeals/{appeal}/decision'
*/
const decideForm = (args: { appeal: string | number } | [appeal: string | number ] | string | number, options?: RouteQueryOptions): RouteFormDefinition<'post'> => ({
    action: decide.url(args, options),
    method: 'post',
})

/**
* @see \BAGArt\TelegramBotAntispam\Http\Controllers\AntispamAppealsController::decide
* @see misc/BAGArt/telegram-bot-antispam-module/src/Http/Controllers/AntispamAppealsController.php:69
* @route '/antispam/appeals/{appeal}/decision'
*/
decideForm.post = (args: { appeal: string | number } | [appeal: string | number ] | string | number, options?: RouteQueryOptions): RouteFormDefinition<'post'> => ({
    action: decide.url(args, options),
    method: 'post',
})

decide.form = decideForm

const appeals = {
    index: Object.assign(index, index),
    decide: Object.assign(decide, decide),
}

export default appeals