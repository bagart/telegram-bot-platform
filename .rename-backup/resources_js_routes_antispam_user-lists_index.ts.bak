* @see \BAGArt\TelegramBotAntispam\Http\Controllers\AntispamUserListsController::destroy
* @see misc/BAGArt/telegram-bot-antispam-module/src/Http/Controllers/AntispamUserListsController.php:103
* @route '/antispam/user-lists/{entry}'
*/
export const destroy = (args: { entry: string | { id: string } } | [entry: string | { id: string } ] | string | { id: string }, options?: RouteQueryOptions): RouteDefinition<'delete'> => ({
    url: destroy.url(args, options),
    method: 'delete',
})

destroy.definition = {
    methods: ["delete"],
    url: '/antispam/user-lists/{entry}',
} satisfies RouteDefinition<["delete"]>

/**
* @see \BAGArt\TelegramBotAntispam\Http\Controllers\AntispamUserListsController::destroy
* @see misc/BAGArt/telegram-bot-antispam-module/src/Http/Controllers/AntispamUserListsController.php:103
* @route '/antispam/user-lists/{entry}'
*/
destroy.url = (args: { entry: string | { id: string } } | [entry: string | { id: string } ] | string | { id: string }, options?: RouteQueryOptions) => {
    if (typeof args === 'string' || typeof args === 'number') {
        args = { entry: args }
    }

    if (typeof args === 'object' && !Array.isArray(args) && 'id' in args) {
        args = { entry: args.id }
    }

    if (Array.isArray(args)) {
        args = {
            entry: args[0],
        }
    }

    args = applyUrlDefaults(args)

    const parsedArgs = {
        entry: typeof args.entry === 'object'
        ? args.entry.id
        : args.entry,
    }

    return destroy.definition.url
            .replace('{entry}', parsedArgs.entry.toString())
            .replace(/\/+$/, '') + queryParams(options)
}

