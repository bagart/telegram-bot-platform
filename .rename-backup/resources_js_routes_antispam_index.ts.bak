* @route '/antispam/dashboard'
*/
export const dashboard = (options?: RouteQueryOptions): RouteDefinition<'get'> => ({
    url: dashboard.url(options),
    method: 'get',
})

dashboard.definition = {
    methods: ["get","head"],
    url: '/antispam/dashboard',
} satisfies RouteDefinition<["get","head"]>

/**
* @see \BAGArt\TelegramBotAntispam\Http\Controllers\AntispamDashboardController::dashboard
* @see misc/BAGArt/telegram-bot-antispam-module/src/Http/Controllers/AntispamDashboardController.php:14
* @route '/antispam/dashboard'
*/
dashboard.url = (options?: RouteQueryOptions) => {
    return dashboard.definition.url + queryParams(options)
}

/**
* @see \BAGArt\TelegramBotAntispam\Http\Controllers\AntispamDashboardController::dashboard
* @see misc/BAGArt/telegram-bot-antispam-module/src/Http/Controllers/AntispamDashboardController.php:14
