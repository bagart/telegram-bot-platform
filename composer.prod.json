{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bagart/telegram-bot-platform",
    "description": "Prod-mode overlay manifest: bagart/* resolved as versioned packages from VCS sources; the misc/ tree and path repositories are absent on servers.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-curl": "*",
        "ext-redis": "*",
        "ext-zlib": "*",
        "bagart/async-kernel": "@dev",
        "bagart/ask-client": "@dev",
        "bagart/ask-client-redis": "@dev",
        "bagart/telegram-bot-lib": "@dev",
        "bagart/telegram-bot-basic-lib": "@dev",
        "bagart/telegram-bot-management": "@dev",
        "bagart/telegram-bot-antispam-module": "@dev",
        "bagart/telegram-bot-summarizer-module": "@dev",
        "bagart/telegram-bot-nettools-module": "@dev",
        "bagart/telegram-bot-tts-module": "@dev",
        "bagart/telegram-bot-stt-module": "@dev",
        "bagart/telegram-game-mafia": "@dev",
        "darkaonline/l5-swagger": "^8.6",
        "inertiajs/inertia-laravel": "^2.0",
        "laravel/fortify": "^1.34",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.14",
        "psr/simple-cache": "*"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/bagart/php-async-kernel-lib.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bagart/php-async-kernel-client.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bagart/php-async-kernel-client-redis.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bagart/telegram-bot-lib.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bagart/telegram-bot-basic-lib.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bagart/telegram-bot-management.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bagart/telegram-bot-antispam-module.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bagart/telegram-bot-summarizer-module.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bagart/telegram-bot-nettools-module.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bagart/telegram-bot-tts-module.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bagart/telegram-bot-stt-module.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bagart/telegram-game-mafia.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "test": [
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
