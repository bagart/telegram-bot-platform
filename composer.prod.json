{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bagart/telegram-bot-platform",
    "description": "Prod-mode overlay manifest: bagart/* resolved as versioned packages from VCS sources; the misc/ tree and path repositories are absent on servers.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-curl": "*",
        "ext-redis": "*",
        "ext-zlib": "*",
        "bagart/async-kernel": "@dev",
        "bagart/ask-client": "@dev",
        "bagart/ask-client-redis": "@dev",
        "bagart/ask-queue": "@dev",
        "bagart/telegram-bot-lib": "@dev",
        "bagart/telegram-bot-lib-basic": "@dev",
        "bagart/telegram-platform-management": "@dev",
        "bagart/tgbot-module-antispam": "@dev",
        "bagart/tgbot-module-summarizer": "@dev",
        "bagart/tgbot-module-nettools": "@dev",
        "bagart/tgbot-module-tts": "@dev",
        "bagart/tgbot-module-stt": "@dev",
        "bagart/tgbot-game-mafia": "@dev",
        "bagart/telegram-platform-module": "@dev",
        "bagart/telegram-platform-menu": "@dev",
        "bagart/tgbot-module-proxy": "@dev",
        "bagart/telegram-platform-access": "@dev",
        "bagart/telegram-platform-audit": "@dev",
        "darkaonline/l5-swagger": "^8.6",
        "inertiajs/inertia-laravel": "^2.0",
        "laravel/fortify": "^1.34",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.14",
        "psr/simple-cache": "*"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/bagart/php-async-kernel-lib.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bagart/php-async-kernel-client.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bagart/php-async-kernel-client-redis.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bagart/telegram-bot-lib.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bagart/telegram-bot-lib-basic.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bagart/telegram-platform-management.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bagart/tgbot-module-antispam.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bagart/tgbot-module-summarizer.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bagart/tgbot-module-nettools.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bagart/tgbot-module-tts.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bagart/tgbot-module-stt.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bagart/telegram-platform-audit.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bagart/tgbot-game-mafia.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bagart/telegram-platform-module.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bagart/telegram-platform-menu.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bagart/tgbot-module-proxy.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bagart/telegram-platform-access.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bagart/telegram-platform-devops-baseline.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bagart/ask-queue.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "test": [
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "process-timeout": 1800,
        "allow-plugins": {
            "php-http/discovery": true,
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "require-dev": {
        "ext-xhprof": "*",
        "amphp/dns": "^2.4",
        "amphp/http-client": "^5.0",
        "barryvdh/laravel-ide-helper": "^3.7",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "*",
        "laravel/boost": "^2.0",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-laravel": "^4.1",
        "react/dns": "^1.14",
        "bagart/telegram-platform-devops-baseline": "@dev"
    },
    "autoload-dev": {
        "psr-4": {
            "BAGArt\\AskQueue\\Tests\\": "misc/BAGArt/ask-queue/tests/",
            "BAGArt\\ASKClientRedis\\Tests\\": "misc/BAGArt/php-async-kernel-client-redis/tests/",
            "BAGArt\\ASKClient\\Tests\\": "misc/BAGArt/php-async-kernel-client/tests/",
            "BAGArt\\AsyncKernel\\Tests\\": "misc/BAGArt/php-async-kernel-lib/tests/",
            "BAGArt\\TelegramBotBasic\\Tests\\": "misc/BAGArt/telegram-bot-lib-basic/tests/",
            "BAGArt\\TelegramBotAntispam\\Tests\\": "misc/BAGArt/tgbot-module-antispam/tests/",
            "BAGArt\\TelegramBotSummarizer\\Tests\\": "misc/BAGArt/tgbot-module-summarizer/tests/",
            "BAGArt\\TelegramBotTts\\Tests\\": "misc/BAGArt/tgbot-module-tts/tests/",
            "BAGArt\\TelegramBotStt\\Tests\\": "misc/BAGArt/tgbot-module-stt/tests/",
            "BAGArt\\TelegramBotMafia\\Tests\\": "misc/BAGArt/tgbot-game-mafia/tests/",
            "BAGArt\\TelegramBotManagement\\Tests\\": "misc/BAGArt/telegram-platform-management/tests/",
            "BAGArt\\TelegramBotMenu\\Tests\\": "misc/BAGArt/telegram-platform-menu/tests/",
            "BAGArt\\TelegramBotNettools\\Tests\\": "misc/BAGArt/tgbot-module-nettools/tests/",
            "BAGArt\\ProxyOperations\\Tests\\": "misc/BAGArt/tgbot-module-proxy/tests/",
            "BAGArt\\TelegramBot\\Tests\\": "misc/BAGArt/telegram-bot-lib/tests/",
            "Tests\\": "tests/",
            "BAGArt\\TelegramModuleEngine\\Tests\\": "misc/BAGArt/telegram-platform-module/tests/",
            "BAGArt\\TelegramBotAccess\\Tests\\": "misc/BAGArt/telegram-platform-access/tests/",
            "BAGArt\\TelegramBotAudit\\Tests\\": "misc/BAGArt/telegram-platform-audit/tests/"
        },
        "files": []
    }
}
