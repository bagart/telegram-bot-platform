{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/react-starter-kit",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "telegram",
        "telegram-bot",
        "telegram-bot-platform"
    ],
    "authors": [
        {
            "name": "BAGArt (Artur Baltaev)",
            "email": "baltaev.artur+ask@gmail.com"
        }
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-curl": "*",
        "ext-redis": "*",
        "ext-zlib": "*",
        "darkaonline/l5-swagger": "^8.6",
        "inertiajs/inertia-laravel": "^2.0",
        "laravel/fortify": "^1.34",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.14",
        "psr/simple-cache": "*"
    },
    "require-dev": {
        "ext-xhprof": "*",
        "amphp/dns": "^2.4",
        "barryvdh/laravel-ide-helper": "^3.7",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "*",
        "laravel/boost": "^2.0",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-laravel": "^4.1",
        "react/dns": "^1.14",
        "bagart/telegram-platform-devops-baseline": "@dev"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "BAGArt\\ASKClientRedis\\": "misc/BAGArt/php-async-kernel-client-redis/src/",
            "BAGArt\\ASKClient\\": "misc/BAGArt/php-async-kernel-client/src/",
            "BAGArt\\AsyncKernel\\": "misc/BAGArt/php-async-kernel-lib/src/",
            "BAGArt\\TelegramBotBasic\\": "misc/BAGArt/telegram-bot-lib-basic/src/",
            "BAGArt\\TelegramBotAntispam\\": "misc/BAGArt/tgbot-module-antispam/src/",
            "BAGArt\\TelegramBotAntispam\\Database\\Factories\\": "misc/BAGArt/tgbot-module-antispam/database/factories/",
            "BAGArt\\TelegramBotAntispam\\Database\\Seeders\\": "misc/BAGArt/tgbot-module-antispam/database/seeders/",
            "BAGArt\\TelegramBotSummarizer\\": "misc/BAGArt/tgbot-module-summarizer/src/",
            "BAGArt\\TelegramBotSummarizer\\Database\\Factories\\": "misc/BAGArt/tgbot-module-summarizer/database/factories/",
            "BAGArt\\TelegramBotStt\\": "misc/BAGArt/tgbot-module-stt/src/",
            "BAGArt\\TelegramBotTts\\": "misc/BAGArt/tgbot-module-tts/src/",
            "BAGArt\\TelegramBotNettools\\": "misc/BAGArt/tgbot-module-nettools/src/",
            "BAGArt\\ProxyOperations\\": "misc/BAGArt/tgbot-module-proxy/src/",
            "BAGArt\\ProxyOperations\\Database\\Factories\\": "misc/BAGArt/tgbot-module-proxy/database/factories/",
            "BAGArt\\TelegramBotMafia\\": "misc/BAGArt/tgbot-game-mafia/src/",
            "BAGArt\\TelegramBotManagement\\": "misc/BAGArt/telegram-platform-management/src/",
            "BAGArt\\TelegramBotMenu\\": "misc/BAGArt/telegram-platform-menu/src/",
            "BAGArt\\TelegramBot\\": "misc/BAGArt/telegram-bot-lib/src/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "BAGArt\\TelegramModuleEngine\\": "misc/BAGArt/telegram-platform-module/src/",
            "BAGArt\\TelegramBotAccess\\": "misc/BAGArt/telegram-platform-access/src/",
            "BAGArt\\TelegramBotAudit\\": "misc/BAGArt/telegram-platform-audit/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BAGArt\\ASKClientRedis\\Tests\\": "misc/BAGArt/php-async-kernel-client-redis/tests/",
            "BAGArt\\ASKClient\\Tests\\": "misc/BAGArt/php-async-kernel-client/tests/",
            "BAGArt\\AsyncKernel\\Tests\\": "misc/BAGArt/php-async-kernel-lib/tests/",
            "BAGArt\\TelegramBotBasic\\Tests\\": "misc/BAGArt/telegram-bot-lib-basic/tests/",
            "BAGArt\\TelegramBotAntispam\\Tests\\": "misc/BAGArt/tgbot-module-antispam/tests/",
            "BAGArt\\TelegramBotSummarizer\\Tests\\": "misc/BAGArt/tgbot-module-summarizer/tests/",
            "BAGArt\\TelegramBotTts\\Tests\\": "misc/BAGArt/tgbot-module-tts/tests/",
            "BAGArt\\TelegramBotStt\\Tests\\": "misc/BAGArt/tgbot-module-stt/tests/",
            "BAGArt\\TelegramBotMafia\\Tests\\": "misc/BAGArt/tgbot-game-mafia/tests/",
            "BAGArt\\TelegramBotManagement\\Tests\\": "misc/BAGArt/telegram-platform-management/tests/",
            "BAGArt\\TelegramBotMenu\\Tests\\": "misc/BAGArt/telegram-platform-menu/tests/",
            "BAGArt\\TelegramBotNettools\\Tests\\": "misc/BAGArt/tgbot-module-nettools/tests/",
            "BAGArt\\ProxyOperations\\Tests\\": "misc/BAGArt/tgbot-module-proxy/tests/",
            "BAGArt\\TelegramBot\\Tests\\": "misc/BAGArt/telegram-bot-lib/tests/",
            "Tests\\": "tests/",
            "BAGArt\\TelegramModuleEngine\\Tests\\": "misc/BAGArt/telegram-platform-module/tests/",
            "BAGArt\\TelegramBotAccess\\Tests\\": "misc/BAGArt/telegram-platform-access/tests/",
            "BAGArt\\TelegramBotAudit\\Tests\\": "misc/BAGArt/telegram-platform-audit/tests/"
        },
        "files": []
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "dev:ssr": [
            "npm run build:ssr",
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"php artisan inertia:start-ssr\" --names=server,queue,logs,ssr --kill-others"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "npm run lint:check",
            "npm run format:check",
            "npm run types:check",
            "@test"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@php artisan test",
            "cd misc/BAGArt/telegram-bot-lib && composer test",
            "cd misc/BAGArt/telegram-bot-lib-basic && composer test",
            "cd misc/BAGArt/tgbot-module-antispam && composer test",
            "cd misc/BAGArt/tgbot-module-nettools && composer test",
            "cd misc/BAGArt/telegram-platform-management && composer test",
            "cd misc/BAGArt/tgbot-module-tts && composer test",
            "cd misc/BAGArt/tgbot-module-stt && composer test",
            "cd misc/BAGArt/tgbot-module-summarizer && composer test",
            "cd misc/BAGArt/tgbot-game-mafia && composer test",
            "cd misc/BAGArt/telegram-platform-menu && composer test",
            "cd misc/BAGArt/tgbot-module-proxy && composer test",
            "cd misc/BAGArt/telegram-platform-module && composer test",
            "cd misc/BAGArt/telegram-platform-access && composer test",
            "cd misc/BAGArt/telegram-platform-audit && composer test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "misc/BAGArt/php-async-kernel-client-redis"
        },
        {
            "type": "path",
            "url": "misc/BAGArt/php-async-kernel-client"
        },
        {
            "type": "path",
            "url": "misc/BAGArt/php-async-kernel-lib"
        },
        {
            "type": "path",
            "url": "misc/BAGArt/telegram-bot-lib-basic"
        },
        {
            "type": "path",
            "url": "misc/BAGArt/tgbot-module-antispam"
        },
        {
            "type": "path",
            "url": "misc/BAGArt/tgbot-module-summarizer"
        },
        {
            "type": "path",
            "url": "misc/BAGArt/tgbot-module-tts"
        },
        {
            "type": "path",
            "url": "misc/BAGArt/tgbot-module-stt"
        },
        {
            "type": "path",
            "url": "misc/BAGArt/telegram-bot-lib"
        },
        {
            "type": "path",
            "url": "misc/BAGArt/telegram-platform-management"
        },
        {
            "type": "path",
            "url": "misc/BAGArt/tgbot-game-mafia"
        },
        {
            "type": "path",
            "url": "misc/BAGArt/tgbot-module-nettools"
        },
        {
            "type": "path",
            "url": "misc/BAGArt/telegram-platform-menu"
        },
        {
            "type": "path",
            "url": "misc/BAGArt/telegram-platform-devops-baseline"
        },
        {
            "type": "path",
            "url": "misc/BAGArt/telegram-platform-module"
        },
        {
            "type": "path",
            "url": "misc/BAGArt/telegram-platform-access"
        },
        {
            "type": "path",
            "url": "misc/BAGArt/telegram-platform-audit"
        },
        {
            "type": "path",
            "url": "misc/BAGArt/tgbot-module-proxy"
        }
    ]
}
