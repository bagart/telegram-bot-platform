#!/usr/bin/env bash
# Baseline drift report (08 §59–§63, 11 §64–§70).
#
# Compares the working tree against tools/baseline/MANIFEST.json and reports
# missing/changed/untracked baseline-owned files plus the installed version.
#
# Usage:
#   cmd/baseline/drift-report [--format=text|json]

set -euo pipefail

SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/root.sh"
source "$REPO_ROOT/cmd/lib/common.sh"
source "$REPO_ROOT/cmd/lib/output.sh"

require_root_dir
cd "$REPO_ROOT"

FORMAT_ARG=""
[[ "${1:-}" == "--format=json" || "${1:-}" == "--json" ]] && FORMAT_ARG="--format=json"

if [[ ! -f tools/baseline/MANIFEST.json ]]; then
  err "No baseline manifest yet — generate one: php tools/baseline/manifest.php --generate"
  exit "$EX_ENV"
fi

VERSION="$(cat tools/baseline/VERSION)"
if [[ -n "$FORMAT_ARG" ]]; then
  php tools/baseline/manifest.php --verify --format=json
else
  say "Baseline version: $VERSION"
  php tools/baseline/manifest.php --verify
fi
