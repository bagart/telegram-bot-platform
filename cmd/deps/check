#!/usr/bin/env bash
# Dual-mode dependency layout control (dev mode: misc/ PSR-4; prod mode: composer.prod.json).
#
# Validates. Items (a)-(c) and (e) need no network access; (d) also probes
# origin branch tips with `git ls-remote` (control lock-tip-fresh:prod,
# reported skipped under --offline):
#   (a) composer.prod.json exists; non-bagart require deps are identical
#       across dev/prod manifests;
#   (b) every misc/BAGArt/* repo that ships tests follows the module layout
#       standard: composer name matches dir, "test" script, phpunit(.dist).xml,
#       src/ + tests/;
#   (c) every module is wired into the root `composer test` chain and has a
#       host phpunit.xml testsuite;
#   (d) locks are present, fresh vs their manifests, and pinned refs match
#       origin tips;
#   (e) packages that are PSR-4-mapped from misc/ are not also composer
#       required in the dev manifest (mode purity).
#
# Exit codes: 0 ok; 1 check failure (drift or stale lock tip); 2 usage;
#   3 dependency; 4 environment; 5 policy failure (stable-tag pin in the
#   prod lock). Check failures dominate policy failures in the composition.
#
# Usage:
#   cmd/deps/check [--mode=dev|prod|both] [--format=text|json|github] [--verbose] [--quiet]

set -euo pipefail

SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/root.sh"
source "$REPO_ROOT/cmd/lib/common.sh"
source "$REPO_ROOT/cmd/lib/output.sh"
source "$REPO_ROOT/cmd/lib/contract.sh"
source "$SCRIPT_DIR/lib.sh"

usage() {
  echo "Usage: cmd/deps/check [--mode=dev|prod|both] [--format=text|json|github] [--verbose] [--quiet]"
  echo "Exit: 0 ok; 1 check failure (drift or stale lock tip); 5 policy failure (stable-tag pin); 2 usage; 3 dependency; 4 environment."
  contract_usage
}

deps_parse_mode both "$@"
contract_parse_args "${POSITIONAL[@]+"${POSITIONAL[@]}"}"
if [[ "$HELP" -eq 1 ]]; then usage; exit "$EX_OK"; fi

require_root_dir
cd "$REPO_ROOT"

FAILS=0
POLICY_FAILS=0

pass_or_fail() {
  local control="$1" ok_flag="$2" message="${3:-}"
  if [[ "$ok_flag" -eq 1 ]]; then
    report_result "$control" passed ""
  else
    report_result "$control" failed "$message"
    FAILS=$((FAILS + 1))
  fi
}

# --- (a) manifests + non-bagart parity --------------------------------------
PARITY_OUT="$(php -r '
$dev = json_decode(file_get_contents("composer.json"), true);
$prod = json_decode(file_get_contents("composer.prod.json"), true);
$strip = static function (array $require): array {
    ksort($require);
    return array_filter($require, static fn ($k) => !str_starts_with($k, "bagart/"), ARRAY_FILTER_USE_KEY);
};
$d = $strip($dev["require"] ?? []);
$p = $strip($prod["require"] ?? []);
echo ($d === $p)
    ? "ok"
    : "drift:\n-dev=" . json_encode($d) . "\n-prod=" . json_encode($p);
' 2>/dev/null)"
if [[ "$PARITY_OUT" == "ok" ]]; then
  pass_or_fail "deps-parity" 1
elif [[ -z "$PARITY_OUT" ]]; then
  pass_or_fail "deps-parity" 0 "manifests unreadable (composer.prod.json missing or invalid PHP)"
else
  pass_or_fail "deps-parity" 0 "$(echo "$PARITY_OUT" | tr '\n' ' ' | cut -c1-200)"
fi

# --- (b)+(c) module layout + wiring -----------------------------------------
# A "module" = misc/BAGArt dir shipping tests whose src implements the
# TgModuleContract plugin interface (matches *-module dirs and nettools).
MODULE_DIRS="$(find misc/BAGArt -mindepth 1 -maxdepth 1 -type d |
  while read -r d; do
    [[ -f "$d/composer.json" && -d "$d/tests" ]] || continue
    if [[ "$d" == *-module ]] ||
       grep -rqE 'implements[[:space:]]+\\?[A-Za-z\\]*TgModuleContract' "$d/src" 2>/dev/null; then
      echo "$d"
    fi
  done | sort)"

ROOT_TEST_CHAIN="$(php -r '$t = json_decode(file_get_contents("composer.json"), true)["scripts"]["test"] ?? []; echo implode(PHP_EOL, array_map("strval", $t));' 2>/dev/null)"
HOST_SUITES="$(grep -oE '<directory>[^<]+</directory>' phpunit.xml || true)"

for m in $MODULE_DIRS; do
  name="$(basename "$m")"
  issues=""

  pkg="$(php -r '$c = json_decode(file_get_contents($argv[1]), true); echo $c["name"] ?? "";' "$m/composer.json" 2>/dev/null)"
  case "$pkg" in
    "bagart/$name"|"bagart/${name%-lib}") ;;
    *) issues+="composer name '$pkg' != bagart/$name; " ;;
  esac

  grep -q '"test"' "$m/composer.json" || issues+="no test script; "
  { [[ -f "$m/phpunit.xml" ]] || [[ -f "$m/phpunit.xml.dist" ]]; } || issues+="no own phpunit(.dist).xml; "
  [[ -d "$m/src" ]] || issues+="no src/; "

  grep -qF "cd $m && composer test" <<<"$ROOT_TEST_CHAIN" ||
    issues+="not chained in root composer test; "

  # Host suite: a testsuite directory pointing into this module's tests.
  grep -qE "<directory>$m/tests" <<<"$HOST_SUITES" || issues+="no host phpunit.xml suite; "

  if [[ -z "$issues" ]]; then
    report_result "module-layout:$name" passed ""
  else
    report_result "module-layout:$name" failed "${issues%; }"
    FAILS=$((FAILS + 1))
  fi
done

# --- (d2) provider wiring: every misc/BAGArt package shipping a top-level
# Laravel service provider must be listed in bootstrap/providers.php, and
# every listed provider must exist on disk (dev-mode PSR-4 mapping).
PROVIDER_OUT="$(php -r '
$providersFile = "bootstrap/providers.php";
$listed = [];
if (is_file($providersFile)) {
    preg_match_all("/([A-Za-z0-9_\\\\]+(?:\\\\[A-Za-z0-9_\\\\]+)+)::class/", file_get_contents($providersFile), $m);
    $listed = $m[1] ?? [];
}
// Phase 3 bootstrap takeover: module providers may alternatively be declared
// in config/tg_modules.php (laravelProvider:) — the engine registers them.
$tgModulesFile = "config/tg_modules.php";
if (is_file($tgModulesFile)) {
    preg_match_all("/laravelProvider:\\s*([A-Za-z0-9_\\\\]+(?:\\\\[A-Za-z0-9_\\\\]+)+)::class/", file_get_contents($tgModulesFile), $mm);
    foreach (($mm[1] ?? []) as $cls) { $listed[] = $cls; }
}

$prefixes = [];
foreach (glob("misc/BAGArt/*/composer.json") ?: [] as $cjPath) {
    $dir = dirname($cjPath);
    $c = json_decode(file_get_contents($cjPath), true);
    foreach (($c["autoload"]["psr-4"] ?? []) as $ns => $path) {
        if (!str_ends_with(rtrim($path, "/"), "src")) { continue; }
        $prefixes[rtrim($ns, "\\")] = $dir."/".rtrim($path, "/");
    }
}

$problems = [];
foreach ($listed as $class) {
    if (!str_starts_with($class, "BAGArt\\")) { continue; }
    $best = "";
    foreach (array_keys($prefixes) as $pfx) {
        if (str_starts_with($class, $pfx."\\") && strlen($pfx) > strlen($best)) { $best = $pfx; }
    }
    if ($best === "") { $problems[] = "listed-but-unmapped:".urlencode($class); continue; }
    $rel = str_replace("\\", "/", substr($class, strlen($best) + 1));
    if (!is_file($prefixes[$best]."/".$rel.".php")) {
        $problems[] = "listed-but-missing:".urlencode($class);
    }
}

foreach ($prefixes as $pfx => $dir) {
    // Only top-level src/*ServiceProvider.php classes are host-bootable;
    // namespaced subproviders are internal wiring of their own package.
    foreach (glob($dir."/*ServiceProvider.php") ?: [] as $sp) {
        $fqcn = $pfx."\\".basename($sp, ".php");
        if (!in_array($fqcn, $listed, true)) { $problems[] = "unregistered-provider:".urlencode($fqcn); }
    }
}

if ($problems) {
    echo trim(implode(";", $problems));
} else {
    echo "ok";
}
' 2>/dev/null)"
if [[ "$PROVIDER_OUT" == "ok" ]]; then
  pass_or_fail "provider-wiring" 1
else
  pass_or_fail "provider-wiring" 0 "${PROVIDER_OUT:-unreadable providers.php}"
fi


# --- (e) mode purity: PSR-4-mapped bagart packages must not be required -----
PURITY_OUT="$(php -r '
$c = json_decode(file_get_contents("composer.json"), true);
$require = $c["require"] ?? [];
$mapped = [];
foreach (($c["autoload"]["psr-4"] ?? []) as $ns => $path) {
    if (str_starts_with($path, "misc/BAGArt/")) {
        $cj = rtrim($path, "/") . "/composer.json";
        if (is_file($cj)) {
            $name = json_decode(file_get_contents($cj), true)["name"] ?? "";
            if ($name !== "") { $mapped[$name] = true; }
        }
    }
}
$bad = array_keys(array_filter($mapped, static fn ($n) => isset($require[$n]), ARRAY_FILTER_USE_KEY));
sort($bad);
echo $bad ? implode(",", $bad) : "ok";
' 2>/dev/null)"
if [[ "$PURITY_OUT" == "ok" ]]; then
  pass_or_fail "deps-mode-purity" 1
else
  pass_or_fail "deps-mode-purity" 0 "PSR-4-mapped packages still required: ${PURITY_OUT:-unreadable composer.json}"
fi

# --- (d) lock freshness ------------------------------------------------------
if [[ "$MODE" == "prod" ]]; then
  report_result "lock-fresh:dev" skipped "prod mode: dev lock not checked"
else
  DEV_LOCK_FRESH=1 DEV_LOCK_MSG=""
  if ! command -v composer >/dev/null 2>&1; then
    DEV_LOCK_FRESH=0
    DEV_LOCK_MSG="composer not found"
  elif ! composer validate --check-lock --no-check-publish --quiet 2>/dev/null; then
    DEV_LOCK_FRESH=0
    DEV_LOCK_MSG="composer.lock stale vs composer.json (run cmd/deps/update)"
  fi
  pass_or_fail "lock-fresh:dev" "$DEV_LOCK_FRESH" "$DEV_LOCK_MSG"
fi

if [[ "$MODE" == "dev" ]]; then
  report_result "lock-fresh:prod" skipped "dev mode: prod lock not checked"
  report_result "lock-tip-fresh:prod" skipped "dev mode: prod lock not checked"
elif [[ ! -f "$PROD_MANIFEST" ]]; then
  report_result "lock-fresh:prod" skipped "$PROD_MANIFEST missing"
  report_result "lock-tip-fresh:prod" skipped "$PROD_MANIFEST missing"
elif [[ ! -f "$PROD_LOCK" ]]; then
  report_result "lock-fresh:prod" skipped "$PROD_LOCK not generated yet (needs published VCS sources)"
  report_result "lock-tip-fresh:prod" skipped "$PROD_LOCK not generated yet (needs published VCS sources)"
else
  PROD_OK=1 PROD_MSG=""
  if ! COMPOSER="$PROD_MANIFEST" composer validate --check-lock --no-check-publish --quiet 2>/dev/null; then
    PROD_OK=0
    PROD_MSG="prod lock stale or invalid vs $PROD_MANIFEST"
  fi
  prod_lock_is_pure "$PROD_LOCK" || { PROD_OK=0; PROD_MSG+=" ; purity violation"; }
  pass_or_fail "lock-fresh:prod" "$PROD_OK" "$PROD_MSG"

  # lock-tip-fresh:prod — every bagart/* pinned ref vs the current tip of the
  # branch its dev-<branch> version names; a non-dev pin is a policy finding.
  if [[ "$OFFLINE" -eq 1 ]]; then
    report_result "lock-tip-fresh:prod" skipped "--offline: origin tips not queried"
  else
    require_cmd git
    TIP_ARGS=(--lock "$PROD_LOCK")
    if [[ "$VERBOSE" -eq 1 ]]; then
      TIP_ARGS+=(--verbose)
    fi
    TIP_OUT="" TIP_RC=0
    TIP_OUT="$(php "$SCRIPT_DIR/lock-tip.php" "${TIP_ARGS[@]}")" || TIP_RC=$?
    if [[ "$VERBOSE" -eq 1 ]]; then
      printf '%s\n' "$TIP_OUT" >&2
    fi

    TIP_FRESH=0 TIP_STALE=0 TIP_HIJACK=0 TIP_SKIPPED=0
    TIP_SUMMARY="$(grep -E '^summary: fresh=' <<<"$TIP_OUT" | tail -n 1 || true)"
    if [[ "$TIP_SUMMARY" =~ fresh=([0-9]+)\ stale=([0-9]+)\ hijack=([0-9]+)\ skipped=([0-9]+) ]]; then
      TIP_FRESH="${BASH_REMATCH[1]}"
      TIP_STALE="${BASH_REMATCH[2]}"
      TIP_HIJACK="${BASH_REMATCH[3]}"
      TIP_SKIPPED="${BASH_REMATCH[4]}"
    fi
    TIP_FINDINGS="$(grep -E '^(stale-lock-tip:|stable-tag-pin:)' <<<"$TIP_OUT" | paste -sd ';' - || true)"
    TIP_SKIPS="$(grep -E '^skipped:' <<<"$TIP_OUT" | paste -sd ';' - || true)"

    case "$TIP_RC" in
      0)
        if (( TIP_FRESH == 0 && TIP_STALE == 0 && TIP_HIJACK == 0 )); then
          report_result "lock-tip-fresh:prod" skipped "skipped=$TIP_SKIPPED${TIP_SKIPS:+ — $TIP_SKIPS}"
        else
          TIP_MSG="fresh=$TIP_FRESH"
          if (( TIP_SKIPPED > 0 )); then
            TIP_MSG+=" ; skipped=$TIP_SKIPPED"
          fi
          report_result "lock-tip-fresh:prod" passed "$TIP_MSG"
        fi
        ;;
      1)
        TIP_MSG="$TIP_FINDINGS"
        if [[ -z "$TIP_MSG" ]]; then
          TIP_MSG="lock tip comparison failed (exit $TIP_RC): ${TIP_OUT:0:200}"
        elif (( TIP_SKIPPED > 0 )); then
          TIP_MSG+=" ; skipped=$TIP_SKIPPED"
        fi
        pass_or_fail "lock-tip-fresh:prod" 0 "$TIP_MSG"
        ;;
      5)
        TIP_MSG="$TIP_FINDINGS"
        if [[ -z "$TIP_MSG" ]]; then
          TIP_MSG="stable-tag pin reported but no finding parsed (exit $TIP_RC)"
        elif (( TIP_SKIPPED > 0 )); then
          TIP_MSG+=" ; skipped=$TIP_SKIPPED"
        fi
        report_result "lock-tip-fresh:prod" failed "$TIP_MSG"
        POLICY_FAILS=$((POLICY_FAILS + 1))
        ;;
      3)
        exit "$EX_DEP"
        ;;
      *)
        pass_or_fail "lock-tip-fresh:prod" 0 "lock tip comparison failed (exit $TIP_RC): ${TIP_OUT:0:200}"
        ;;
    esac
  fi
fi

report_finish "$(( FAILS > 0 ? EX_CHECK : (POLICY_FAILS > 0 ? EX_POLICY : EX_OK) ))"
