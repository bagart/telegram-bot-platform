#!/usr/bin/env bash
# Check for outdated dependencies.
#
# Usage:
#   cmd/deps/outdated

set -euo pipefail

SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/root.sh"
source "$REPO_ROOT/cmd/lib/common.sh"
source "$REPO_ROOT/cmd/lib/output.sh"
source "$SCRIPT_DIR/lib.sh"

usage() {
  echo "Usage: cmd/deps/outdated [--mode=dev|prod|both]"
}

deps_parse_mode both "$@"
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then usage; exit "$EX_OK"; fi

require_root_dir
cd "$REPO_ROOT"

if command -v composer >/dev/null 2>&1; then
  if [[ "$MODE" != "prod" ]]; then
    say "Composer outdated (dev)..."
    composer outdated --direct 2>&1 || true
  fi
  if [[ "$MODE" != "dev" ]]; then
    if [[ -f "$PROD_LOCK" ]]; then
      say "Composer outdated (prod)..."
      COMPOSER="$PROD_MANIFEST" composer outdated --direct 2>&1 || true
    else
      warn "$PROD_LOCK not generated yet — prod outdated skipped"
    fi
  fi
else
  warn "Composer not found — skipping"
fi

if command -v npm >/dev/null 2>&1 && [[ -f package.json ]]; then
  say "npm outdated..."
  npm outdated 2>&1 || true
else
  warn "npm or package.json not found — skipping"
fi
