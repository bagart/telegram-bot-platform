#!/usr/bin/env bash
# Update dependencies per mode.
#
# Usage:
#   cmd/deps/update [--mode=dev|prod|both] [composer|npm]
#
#   dev   — composer update against composer.json (+ npm when targeted/all)
#   prod  — COMPOSER=composer.prod.json update --no-install; fails on path/symlink drift
#   both  — dev first, then prod lock refresh
#
# After a dev composer update the reviewed composer scripts baseline is
# re-checked automatically (A3 rule: intentional change -> baselines regenerated).

set -euo pipefail

SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/root.sh"
source "$REPO_ROOT/cmd/lib/common.sh"
source "$REPO_ROOT/cmd/lib/output.sh"
source "$REPO_ROOT/cmd/lib/contract.sh"
source "$SCRIPT_DIR/lib.sh"

usage() {
  echo "Usage: cmd/deps/update [--mode=dev|prod|both] [composer|npm] [--format=text|json|github] [--verbose] [--quiet]"
  contract_usage
}

deps_parse_mode both "$@"
contract_parse_args "${POSITIONAL[@]+"${POSITIONAL[@]}"}"
if [[ "$HELP" -eq 1 ]]; then usage; exit "$EX_OK"; fi

require_root_dir
cd "$REPO_ROOT"

TARGET="${POSITIONAL[0]:-all}"
case "$TARGET" in all|composer|npm) ;; *) fail "Unknown target '$TARGET' (expected all|composer|npm)" ;; esac

FAILS=0

run_dev_composer() {
  command -v composer >/dev/null 2>&1 || { warn "Composer not found — skipping"; return 0; }
  say "Updating Composer dependencies (dev)..."
  if ! composer update --no-interaction --no-progress; then
    err "dev composer update failed"
    FAILS=$((FAILS + 1))
    return 0
  fi
  ok "Composer updated (dev)"
  if [[ -f tools/baseline/composer-policy.php ]]; then
    if php tools/baseline/composer-policy.php --check=all > /tmp/deps-policy.log 2>&1; then
      ok "composer scripts baseline in sync"
    else
      err "composer policy drift after update — review and run with --update"
      tail -n 5 /tmp/deps-policy.log >&2
      FAILS=$((FAILS + 1))
    fi
  fi
}

run_prod_composer() {
  require_prod_manifest
  command -v composer >/dev/null 2>&1 || { warn "Composer not found — skipping"; return 0; }
  say "Updating Composer dependencies (prod, lock-only)..."
  local tmp
  tmp="$(mktemp)"
  if COMPOSER="$PROD_MANIFEST" composer update --no-install --no-progress --no-interaction >"$tmp" 2>&1; then
    if prod_lock_is_pure "$PROD_LOCK"; then
      ok "Prod lock refreshed"
    else
      FAILS=$((FAILS + 1))
    fi
  else
    err "prod lock refresh failed (are bagart/* sources published and reachable?)"
    tail -n 3 "$tmp" | tr '\n' ' ' | cut -c1-200 >&2
    [[ "$VERBOSE" -eq 1 ]] && cat "$tmp" >&2
    FAILS=$((FAILS + 1))
  fi
  rm -f "$tmp"
}

if [[ "$MODE" != "prod" && ( "$TARGET" == "all" || "$TARGET" == "composer" ) ]]; then
  run_dev_composer
fi

if [[ "$MODE" != "dev" && ( "$TARGET" == "all" || "$TARGET" == "composer" ) ]]; then
  run_prod_composer
fi

if [[ "$MODE" == "dev" && ( "$TARGET" == "all" || "$TARGET" == "npm" ) ]]; then
  if command -v npm >/dev/null 2>&1 && [[ -f package.json ]]; then
    say "Updating npm dependencies..."
    npm update 2>&1 || { err "npm update failed"; FAILS=$((FAILS + 1)); }
    ok "npm updated"
  else
    warn "npm or package.json not found — skipping"
  fi
fi

report_finish "$(( FAILS > 0 ? EX_CHECK : EX_OK ))" "update complete (mode=$MODE)"
