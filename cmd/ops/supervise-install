#!/usr/bin/env bash
# Install host-side supervision units (06-runtime-operations.md §12–§15).
#
# Copies the templated systemd unit and enables it for the requested daemon
# names. Requires root on the deployment host; the repository checkout must
# live at /opt/telegram-bot-platform (override with BASELINE_APP_DIR).
#
# This is an INFRA step: it touches the host, so it demands confirmation.
#
# Usage:
#   cmd/ops/supervise-install <daemon-name...> [--confirm=supervisor]
# Example:
#   cmd/ops/supervise-install outbound --confirm=supervisor

set -euo pipefail

SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/root.sh"
source "$REPO_ROOT/cmd/lib/common.sh"
source "$REPO_ROOT/cmd/lib/output.sh"

DAEMONS=()
CONFIRMED=0
for arg in "$@"; do
  case "$arg" in
    --confirm=supervisor) CONFIRMED=1 ;;
    *) DAEMONS+=("$arg") ;;
  esac
done

(( ${#DAEMONS[@]} > 0 )) || fail "Usage: cmd/ops/supervise-install <daemon-name...> [--confirm=supervisor]"
(( CONFIRMED )) || fail "Supervision changes the host — rerun with --confirm=supervisor"

[[ $EUID -eq 0 ]] || { err "must run as root on the deployment host"; exit "$EX_ENV"; }

APP_DIR="${BASELINE_APP_DIR:-/opt/telegram-bot-platform}"
UNIT_SRC="$APP_DIR/deploy/systemd/tg-daemon@.service"
[[ -f "$UNIT_SRC" ]] || { err "unit template missing: $UNIT_SRC"; exit "$EX_ENV"; }

cp "$UNIT_SRC" /etc/systemd/system/
mkdir -p "$APP_DIR"
sed -i "s|/opt/telegram-bot-platform|$APP_DIR|g" /etc/systemd/system/tg-daemon@.service
systemctl daemon-reload

for d in "${DAEMONS[@]}"; do
  systemctl enable "tg-daemon@$d.service"
  say "enabled tg-daemon@$d (start: systemctl start tg-daemon@$d)"
done

ok "Supervision installed. Crash-loop backoff and Restart=on-failure are active."
say "Watchdog (advisory): schedule tools/ops/watchdog.sh --pid \$(pgrep -f 'artisan tg:daemons') via cron — see tools/baseline/crontab.example"
