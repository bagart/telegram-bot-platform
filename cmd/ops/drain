#!/usr/bin/env bash
# Graceful drain (06-runtime-operations.md §4-§5, §48).
#
# Asks queue workers to finish current work and stop accepting new jobs.
# Containers are NOT stopped implicitly; pass --containers to also stop the
# compose worker services after the signal.
#
# Usage:
#   cmd/ops/drain [--containers]

set -euo pipefail

SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/root.sh"
source "$REPO_ROOT/cmd/lib/common.sh"
source "$REPO_ROOT/cmd/lib/output.sh"

require_root_dir
cd "$REPO_ROOT"

command -v php >/dev/null 2>&1 || { err "php is required"; exit "$EX_DEP"; }

say "Signalling workers to drain (finish current jobs, accept no new work)"
php artisan queue:restart 2>/dev/null || { err "queue:restart failed — is the application configured?"; exit "$EX_ENV"; }
ok "Drain signal sent"

if [[ "${1:-}" == "--containers" ]]; then
  command -v docker >/dev/null 2>&1 || { err "docker is required for --containers"; exit "$EX_DEP"; }
  say "Stopping worker containers"
  if docker compose -f docker-compose.dev.yaml stop php-fpm workspace >/dev/null 2>&1; then
    ok "php-fpm + workspace stopped"
  else
    err "compose stop failed"
    exit "$EX_ENV"
  fi
fi

say "Verify recovery with: cmd/ops/health"
exit "$EX_OK"
