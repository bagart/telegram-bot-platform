#!/usr/bin/env bash
# Verify backup integrity (07-resilience-and-disaster-recovery.md §12, §15).
#
# Checks checksum against the recorded .sha256 sidecar and validates the
# gzip stream. This proves the artifact is intact — NOT that it is restorable;
# the periodic isolated restore test remains mandatory.
#
# Usage:
#   cmd/ops/backup-verify [backup-file.sql.gz]   # default: newest

set -euo pipefail

SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/root.sh"
source "$REPO_ROOT/cmd/lib/common.sh"
source "$REPO_ROOT/cmd/lib/output.sh"

require_root_dir
cd "$REPO_ROOT"

BACKUP_DIR="storage/backups"
TARGET="${1:-}"
if [[ -z "$TARGET" ]]; then
  TARGET="$(ls -1t "$BACKUP_DIR"/*.sql.gz 2>/dev/null | head -1 || true)"
fi
[[ -n "$TARGET" && -f "$TARGET" ]] || fail "No backup found in $BACKUP_DIR (run cmd/ops/backup first)"

say "Verifying $(basename "$TARGET")"

if ! sha256sum -c "$TARGET.sha256" >/dev/null 2>&1; then
  err "Checksum mismatch — backup is corrupted or tampered with"
  exit "$EX_CHECK"
fi
ok "checksum OK"

if ! gunzip -t "$TARGET" 2>/dev/null; then
  err "gzip stream invalid"
  exit "$EX_CHECK"
fi
ok "gzip stream OK"

ok "Backup is intact. Remember: verified bytes ≠ proven restorability (07 §13)."
exit "$EX_OK"
