#!/usr/bin/env bash
# Primary local validation gate (02-developer-tooling.md §8–§10).
#
# Levels:
#   (default)  surface-driven fast validation (changed-surface detection)
#   --quick    seconds: formatting, line endings, secrets on staged files
#   --full     complete local validation (static analysis, tests, frontend)
#   --ci       CI-equivalent: --full plus dependency audits
#
# Usage:
#   cmd/dev/check [--quick|--full|--ci] [--format=text|json|github] [--verbose] [--quiet]

set -euo pipefail

SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/root.sh"
source "$REPO_ROOT/cmd/lib/common.sh"
source "$REPO_ROOT/cmd/lib/output.sh"
source "$REPO_ROOT/cmd/lib/contract.sh"

usage() {
  echo "Usage: cmd/dev/check [--quick|--full|--ci] [--format=text|json|github] [--verbose] [--quiet]"
  contract_usage
}

contract_parse_args "$@"
if [[ "$HELP" -eq 1 ]]; then usage; exit "$EX_OK"; fi

require_root_dir
cd "$REPO_ROOT"

LEVEL="${LEVEL:-}"
SURFACES=""

if [[ -z "$LEVEL" ]]; then
  LEVEL="default"
  SURFACES="$(php tools/baseline/changed-surface.php --base=HEAD 2>/dev/null || echo "")"
fi

has_surface() {
  [[ " $SURFACES " == *" $1 "* ]]
}

PROFILES="$(bash tools/baseline/profiles.sh 2>/dev/null || echo "")"
has_profile() {
  [[ " $PROFILES " == *" $1 "* ]]
}

run_tool() {
  local control="$1"; shift
  if [[ "$FORMAT" == "text" && "$QUIET" -eq 0 ]]; then
    say "$control"
  fi
  local tmp
  tmp="$(mktemp)"
  if contract_exec "$control" "$@" >"$tmp" 2>&1; then
    report_result "$control" passed ""
    rm -f "$tmp"
    return 0
  fi
  report_result "$control" failed "$(tail -n 3 "$tmp" | tr '\n' ' ' | cut -c1-200)"
  if [[ "$VERBOSE" -eq 1 ]]; then
    echo "--- $control output ---" >&2
    cat "$tmp" >&2
  fi
  rm -f "$tmp"
  return 1
}

STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACM | head -1)"
LF_SCOPE="--all"
SECRET_SCOPE="--all"
if [[ -n "$STAGED_FILES" ]]; then
  LF_SCOPE="--staged"
  SECRET_SCOPE="--staged"
fi

# Changed-file scopes for quick/default levels (02-developer-tooling.md §9).
CHANGED_PHP="$(git diff --cached --name-only --diff-filter=ACM -- '*.php'; git diff --name-only --diff-filter=ACM -- '*.php')"
if [[ -z "$CHANGED_PHP" ]]; then
  CHANGED_PHP="$(git ls-files --others --exclude-standard -- '*.php' | head -50)"
fi
CHANGED_JS="$(git diff --cached --name-only --diff-filter=ACM -- '*.js' '*.ts' '*.tsx' '*.jsx' '*.vue'; git diff --name-only --diff-filter=ACM -- '*.js' '*.ts' '*.tsx' '*.jsx' '*.vue')"

FAILS=0

# --- Line endings (always; cheap) ---
if ! run_tool "line-endings" php tools/baseline/lf-check.php "$LF_SCOPE"; then FAILS=$((FAILS+1)); fi

# --- Secret scan (always; security must never be skipped) ---
if ! run_tool "secret-scan" php tools/baseline/secret-scan.php "$SECRET_SCOPE"; then FAILS=$((FAILS+1)); fi

# --- PHP formatting + static analysis ---
if [[ "$LEVEL" == "full" || "$LEVEL" == "ci" ]]; then
  if command -v vendor/bin/pint >/dev/null 2>&1; then
    if ! run_tool "pint" vendor/bin/pint --test; then FAILS=$((FAILS+1)); fi
  fi
elif has_surface php && [[ -n "$CHANGED_PHP" ]]; then
  if command -v vendor/bin/pint >/dev/null 2>&1; then
    # shellcheck disable=SC2086
    if ! run_tool "pint (changed)" vendor/bin/pint --test $CHANGED_PHP; then FAILS=$((FAILS+1)); fi
  fi
fi
if [[ "$LEVEL" == "full" || "$LEVEL" == "ci" ]]; then
  if command -v vendor/bin/phpstan >/dev/null 2>&1; then
    if ! run_tool "phpstan" vendor/bin/phpstan analyse --no-progress; then FAILS=$((FAILS+1)); fi
  fi
fi

# --- Frontend ---
if [[ "$LEVEL" == "full" || "$LEVEL" == "ci" ]]; then
  if command -v npx >/dev/null 2>&1 && [[ -f eslint.config.js ]]; then
    if ! run_tool "eslint" npx eslint .; then FAILS=$((FAILS+1)); fi
  fi
elif has_surface frontend && [[ -n "$CHANGED_JS" ]]; then
  if command -v npx >/dev/null 2>&1 && [[ -f eslint.config.js ]]; then
    # shellcheck disable=SC2086
    if ! run_tool "eslint (changed)" npx eslint $CHANGED_JS; then FAILS=$((FAILS+1)); fi
  fi
fi
if [[ "$LEVEL" == "full" || "$LEVEL" == "ci" ]] && has_profile frontend; then
  if command -v npx >/dev/null 2>&1; then
    if ! run_tool "prettier" npx prettier --check resources/; then FAILS=$((FAILS+1)); fi
    if ! run_tool "typescript" npx tsc --noEmit; then FAILS=$((FAILS+1)); fi
  fi
fi

# --- Tests ---
if [[ "$LEVEL" == "full" || "$LEVEL" == "ci" ]]; then
  if [[ -f vendor/bin/pest ]]; then
    if ! run_tool "tests" php artisan test --compact; then FAILS=$((FAILS+1)); fi
  fi
fi

# --- Docker ---
if has_profile docker && { [[ "$LEVEL" == "full" || "$LEVEL" == "ci" ]] || has_surface docker; }; then
  if command -v docker >/dev/null 2>&1; then
    if ! run_tool "compose-dev" docker compose -f docker-compose.dev.yaml config --quiet; then FAILS=$((FAILS+1)); fi
    if [[ -f docker-compose.prod.yaml ]]; then
      if ! run_tool "compose-prod" docker compose -f docker-compose.prod.yaml config --quiet; then FAILS=$((FAILS+1)); fi
    fi
  fi
fi

# --- CI configuration ---
if has_surface ci || [[ "$LEVEL" == "full" || "$LEVEL" == "ci" ]]; then
  if command -v actionlint >/dev/null 2>&1; then
    if ! run_tool "actionlint" actionlint; then FAILS=$((FAILS+1)); fi
  fi
fi

# --- Dependency audit (CI-equivalent mode or dependency changes) ---
if [[ "$OFFLINE" -eq 1 ]]; then
  report_result "composer-audit" skipped "offline mode"
elif [[ "$LEVEL" == "ci" ]] || { [[ "$LEVEL" != "default" ]] && has_surface deps; }; then
  if command -v composer >/dev/null 2>&1; then
    if ! run_tool "composer-audit" composer audit --no-dev; then FAILS=$((FAILS+1)); fi
  fi
fi

SUMMARY="$FAILS control(s) failed"
report_finish "$(( FAILS > 0 ? EX_CHECK : EX_OK ))" "$SUMMARY"
