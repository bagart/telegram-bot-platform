#!/usr/bin/env bash
# Materialize module-owned Inertia pages into the host frontend.
#
# Module UI source lives in the module repo (single source of truth):
#   misc/BAGArt/<module>/resources/js/pages/<page>/*.tsx   (dev mode)
#   vendor/bagart/<module>/resources/js/pages/<page>/*.tsx (prod mode)
#
# The host frontend consumes copies under resources/js/pages/ — these are
# build artifacts: gitignored, regenerated by this script, never edited
# by hand. Re-run after changing module pages.
#
# Usage:
#   cmd/dev/ui-sync [--clean]
#
# Exit codes: 0 = synced, 4 = module source missing.
set -euo pipefail

SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/root.sh"
source "$REPO_ROOT/cmd/lib/common.sh"
source "$REPO_ROOT/cmd/lib/output.sh"

CLEAN=0
[[ "${1:-}" == "--clean" ]] && CLEAN=1

# Entries: "<module-repo>:<page-dir-under-resources/js/pages>"
MODULES=(
  "telegram-bot-antispam-module:antispam"
)

cd "$REPO_ROOT"

for entry in "${MODULES[@]}"; do
  module="${entry%%:*}"
  page="${entry##*:}"
  target="resources/js/pages/${page}"
  dev_src="misc/BAGArt/${module}/resources/js/pages/${page}"
  prod_src="vendor/bagart/${module}/resources/js/pages/${page}"

  if [[ "$CLEAN" -eq 1 ]]; then
    rm -rf "$target"
    ok "removed artifact $target"
    continue
  fi

  src=""
  if [[ -d "$dev_src" ]]; then
    src="$dev_src"
  elif [[ -d "$prod_src" ]]; then
    src="$prod_src"
  else
    err "Module pages not found: $dev_src (or prod $prod_src)"
    exit "$EX_ENV"
  fi

  mkdir -p "$target"
  cp -f "$src"/*.tsx "$target"/
  ok "synced $src -> $target"
done
