#!/usr/bin/env bash
# Bootstrap the repository into a usable development state.
#
# Steps:
#   1. Validate repository structure
#   2. Validate .env exists
#   3. Install PHP dependencies (Composer)
#   4. Install JS dependencies (npm)
#   5. Sync module UI pages (cmd/dev/ui-sync)
#   6. Build frontend assets
#   7. Generate app key (if missing)
#   8. Run database migrations
#   9. Install Git hooks (safe — never overwrites foreign hooks)
#
# Usage:
#   cmd/dev/setup

set -euo pipefail

SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/root.sh"
source "$REPO_ROOT/cmd/lib/common.sh"
source "$REPO_ROOT/cmd/lib/output.sh"

require_root_dir
cd "$REPO_ROOT"

# --- 1. Repository structure ---
say "Validating repository structure..."
for d in app config database public resources routes tests; do
  [[ -d "$d" ]] || fail "Missing directory: $d"
done
[[ -f artisan ]] || fail "Missing artisan"
[[ -f composer.json ]] || fail "Missing composer.json"
ok "Repository structure OK"

# --- 2. .env ---
if [[ ! -f .env ]]; then
  warn ".env not found — copying from .env.example"
  cp .env.example .env
  warn "Edit .env with your settings before continuing"
fi
ok ".env present"

# --- 3. Composer ---
say "Installing PHP dependencies..."
if command -v composer >/dev/null 2>&1; then
  composer install --no-interaction --no-progress 2>&1 | sed 's/^/    /'
  ok "Composer done"
else
  warn "composer not found — skipping PHP dependency install"
fi

# --- 4. npm ---
say "Installing JS dependencies..."
if command -v npm >/dev/null 2>&1; then
  npm install 2>&1 | sed 's/^/    /'
  ok "npm done"
else
  warn "npm not found — skipping JS dependency install"
fi

# --- 5. Frontend build ---
say "Syncing module UI pages..."
"$REPO_ROOT/cmd/dev/ui-sync"

say "Building frontend assets..."
if command -v npm >/dev/null 2>&1 && [[ -f package.json ]]; then
  npm run build 2>&1 | sed 's/^/    /'
  ok "Frontend build done"
else
  warn "Skipping frontend build (npm or package.json missing)"
fi

# --- 6. App key ---
if grep -q "^APP_KEY=$" .env 2>/dev/null; then
  say "Generating application key..."
  php artisan key:generate --no-interaction 2>&1 | sed 's/^/    /'
  ok "App key generated"
else
  ok "App key already set"
fi

# --- 7. Database migrations ---
say "Running database migrations..."
php artisan migrate --no-interaction 2>&1 | sed 's/^/    /'
ok "Migrations done"

# --- 8. Git hooks ---
# Hooks ship with bagart/telegram-platform-devops-baseline
# and are activated via core.hooksPath pointing into vendor/. A fresh clone
# must run `composer install` before its first commit is hook-checked —
# baseline-setup fails loudly when vendor hooks are absent (no silent skip).
HOOKS_PATH="vendor/bagart/telegram-platform-devops-baseline/hooks"

if [[ ! -f "$REPO_ROOT/$HOOKS_PATH/pre-commit" ]]; then
  fail "Missing hooks at $HOOKS_PATH — run 'composer install' first"
fi

CURRENT_HOOKS_PATH="$(git config core.hooksPath || true)"
if [[ "$CURRENT_HOOKS_PATH" != "$HOOKS_PATH" ]]; then
  git config core.hooksPath "$HOOKS_PATH"
  ok "core.hooksPath set to $HOOKS_PATH"
else
  ok "core.hooksPath already set to $HOOKS_PATH"
fi

# Migrate legacy project-owned hook from .git/hooks (foreign hooks are kept).
LEGACY_HOOK=".git/hooks/pre-push"
if [[ -f "$LEGACY_HOOK" ]] && grep -q "# managed-by-telegram-bot-platform" "$LEGACY_HOOK" 2>/dev/null; then
  rm -f "$LEGACY_HOOK"
  ok "Legacy project pre-push hook removed (now managed via core.hooksPath)"
fi

ok "Setup complete"
