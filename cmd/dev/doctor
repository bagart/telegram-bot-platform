#!/usr/bin/env bash
# Diagnose the local development environment.
#
# Reports OK / WARN / FAIL for each check.
# Does not modify anything — read-only diagnosis.
#
# Usage:
#   cmd/dev/doctor [--format=text|json] [--quiet] [--help]

set -euo pipefail

SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/root.sh"
source "$REPO_ROOT/cmd/lib/common.sh"
source "$REPO_ROOT/cmd/lib/output.sh"
source "$REPO_ROOT/cmd/lib/contract.sh"

usage() {
  echo "Usage: cmd/dev/doctor [--format=text|json] [--quiet] [--help]"
  contract_usage
}

contract_parse_args "$@"
if [[ "$HELP" -eq 1 ]]; then usage; exit "$EX_OK"; fi

require_root_dir
cd "$REPO_ROOT"

# Section headers are human-only decoration; keep the JSON stream clean.
if [[ "$FORMAT" != "text" ]]; then
  say() { :; }
fi

FAILS=0
WARNS=0

__doctor_record() {
  local status="$1" message="$2"
  __CONTRACT_RESULTS+=("$(printf '%s' "{\"control\":\"${message//\"/\\\"}\",\"status\":\"${status}\",\"message\":\"\"}")")
}

check_ok()   { [[ "$FORMAT" == "text" && "$QUIET" -eq 0 ]] && ok "$1"; __doctor_record passed "$1"; return 0; }
check_warn() { warn "$1"; WARNS=$((WARNS+1)); __doctor_record warning "$1"; return 0; }
check_fail() { err "$1"; FAILS=$((FAILS+1)); __doctor_record failed "$1"; return 0; }

# --- PHP ---
say "PHP"
if command -v php >/dev/null 2>&1; then
  PHP_VER="$(php -r 'echo PHP_VERSION;' 2>/dev/null)"
  check_ok "PHP $PHP_VER ($(command -v php))"
else
  check_fail "PHP not found"
fi

# --- Composer ---
say "Composer"
if command -v composer >/dev/null 2>&1; then
  COMP_VER="$(composer --version 2>/dev/null | head -1)"
  check_ok "$COMP_VER"
else
  check_warn "Composer not found"
fi

# --- Node / npm ---
say "Node / npm"
if command -v node >/dev/null 2>&1; then
  NODE_VER="$(node -v)"
  check_ok "Node $NODE_VER"
else
  check_warn "Node not found"
fi
if command -v npm >/dev/null 2>&1; then
  NPM_VER="$(npm -v)"
  check_ok "npm $NPM_VER"
else
  check_warn "npm not found"
fi

# --- Docker ---
say "Docker"
if command -v docker >/dev/null 2>&1; then
  DOCKER_VER="$(docker --version 2>/dev/null || true)"
  if [[ -n "$DOCKER_VER" ]]; then
    check_ok "$DOCKER_VER"
  else
    check_fail "docker found but not functional (daemon/context broken?)"
  fi
  if docker compose version >/dev/null 2>&1; then
    COMP_VER="$(docker compose version --short 2>/dev/null || true)"
    check_ok "Docker Compose $COMP_VER"
  else
    check_fail "Docker Compose plugin not found"
  fi
else
  check_warn "Docker not found"
fi

# --- Git ---
say "Git"
if command -v git >/dev/null 2>&1; then
  GIT_VER="$(git --version)"
  check_ok "$GIT_VER"
else
  check_fail "Git not found"
fi

# --- .env ---
say "Environment"
if [[ -f .env ]]; then
  check_ok ".env present"
else
  check_warn ".env not found — run cmd/dev/setup"
fi

# --- Repository structure ---
say "Repository structure"
MISSING=()
for d in app config database public resources routes tests cmd docker; do
  [[ -d "$d" ]] || MISSING+=("$d")
done
if [[ ${#MISSING[@]} -eq 0 ]]; then
  check_ok "All expected directories present"
else
  check_fail "Missing directories: ${MISSING[*]}"
fi

# --- Compose files ---
say "Docker Compose"
if docker compose -f docker-compose.dev.yaml config --quiet >/dev/null 2>&1; then
  check_ok "docker-compose.dev.yaml valid"
else
  check_fail "docker-compose.dev.yaml invalid"
fi
if docker compose -f docker-compose.prod.yaml config --quiet >/dev/null 2>&1; then
  check_ok "docker-compose.prod.yaml valid"
else
  check_fail "docker-compose.prod.yaml invalid"
fi

# --- Git hooks ---
say "Git hooks"
# Hooks ship inside bagart/telegram-devops-baseline (cmd/dev/setup points
# core.hooksPath at the vendor copy); the path-repo checkout is equivalent.
CURRENT_HOOKS_PATH="$(git config core.hooksPath || true)"
CANONICAL_HOOKS_PATH="vendor/bagart/telegram-devops-baseline/hooks"
case "$CURRENT_HOOKS_PATH" in
  *"$CANONICAL_HOOKS_PATH"|*"misc/BAGArt/telegram-devops-baseline/hooks")
    check_ok "core.hooksPath: $CURRENT_HOOKS_PATH"
    for hook in pre-commit commit-msg pre-push; do
      if [[ -x "$CURRENT_HOOKS_PATH/$hook" ]]; then
        check_ok "hook $hook: installed"
      else
        check_fail "hook $hook: missing or not executable (run cmd/dev/setup)"
      fi
    done
    ;;
  *)
    check_warn "core.hooksPath not set to package hooks (got: '${CURRENT_HOOKS_PATH:-<empty>}') — run cmd/dev/setup"
    ;;
esac

# --- Line-ending control ---
say "Line-ending control"
if [[ -f .gitattributes ]] && grep -q "eol=lf" .gitattributes; then
  check_ok ".gitattributes enforces LF"
else
  check_fail ".gitattributes missing or does not enforce eol=lf"
fi
if command -v php >/dev/null 2>&1 && [[ -f tools/baseline/lf-check.php ]]; then
  if php tools/baseline/lf-check.php --all >/dev/null 2>&1; then
    check_ok "tracked files are LF"
  else
    check_fail "CRLF found in tracked files — run: cmd/dev/fix"
  fi
fi

# --- Profiles ---
say "Profiles"
if [[ -f tools/baseline/VERSION ]]; then
  check_ok "baseline version: $(cat tools/baseline/VERSION | tr -d '[:space:]')"
fi
if command -v php >/dev/null 2>&1 && [[ -f tools/baseline/quarantine-check.php ]]; then
  if php tools/baseline/quarantine-check.php >/dev/null 2>&1; then
    check_ok "test quarantine registry valid"
  else
    check_fail "quarantine registry has expired/malformed entries — see: php tools/baseline/quarantine-check.php"
  fi
fi
if [[ -f tools/baseline/profiles.sh ]]; then
  DETECTED="$(bash tools/baseline/profiles.sh 2>/dev/null || true)"
  if [[ -n "$DETECTED" ]]; then
    check_ok "detected: $DETECTED"
  else
    check_warn "no profiles detected"
  fi
fi

# --- Tool version pins (02 §30) ---
say "Tool pins"
if command -v php >/dev/null 2>&1 && [[ -f tools/baseline/tool-versions.json ]]; then
  while IFS=$'\t' read -r tool kind want have; do
    case "$kind" in
      pinned) [[ "$have" == "$want"* ]] && check_ok "$tool $have (pinned $want)" \
                || check_fail "$tool $have != pinned $want — see tools/baseline/tool-versions.json" ;;
      min)    [[ "$(printf '%s\n%s\n' "$want" "$have" | sort -V | head -1)" == "$want" ]] \
                && check_ok "$tool $have (min $want)" \
                || check_fail "$tool $have < required $want — see tools/baseline/tool-versions.json" ;;
    esac
  done < <(php -r '
    $pins = json_decode((string) file_get_contents("tools/baseline/tool-versions.json"), true) ?: [];
    foreach ($pins as $tool => $cfg) {
      if (!is_array($cfg)) continue;
      $want = $cfg["pinned"] ?? $cfg["min"] ?? null;
      if ($want === null) continue;
      $kind = isset($cfg["pinned"]) ? "pinned" : "min";
      $have = ["php" => "php -r \"echo PHP_VERSION;\"", "composer" => "composer --version 2>/dev/null | grep -oP \"\\d+\\.\\d+\\.\\d+\" | head -1",
               "node" => "node -v 2>/dev/null | tr -d v", "gh" => "gh --version 2>/dev/null | grep -oP \"\\d+\\.\\d+\\.\\d+\" | head -1",
               "semgrep" => "semgrep --version 2>/dev/null"]["$tool"] ?? null;
      if ($have === null) { continue; }
      $got = trim((string) shell_exec($have) ?? "");
      echo $got === "" ? "" : implode("\t", [$tool, $kind, ltrim($want, "v"), ltrim($got, "v")]), "\n";
    }
  ' 2>/dev/null)
fi

# --- OmniRoute (AI profile) ---
say "OmniRoute / AI"
if [[ -n "${OMNIROUTE_JWT_SECRET:-}" && -n "${OMNIROUTE_API_KEY_SECRET:-}" && -n "${OMNIROUTE_PASSWORD:-}" ]]; then
  check_ok "AI secrets configured"
else
  check_warn "AI secrets not set — run cmd/docker/up ai will fail until set in .env"
fi

# --- Summary ---
if [[ "$FORMAT" == "json" ]]; then
  CODE="$EX_OK"
  [[ "$FAILS" -gt 0 ]] && CODE="$EX_CHECK"
  printf '{"exit_code":%d,"failures":%d,"warnings":%d,"results":[%s]}\n' \
    "$CODE" "$FAILS" "$WARNS" "$(IFS=,; echo "${__CONTRACT_RESULTS[*]:-}")"
  exit "$CODE"
fi

echo ""
if [[ $FAILS -gt 0 ]]; then
  err "$FAILS failure(s), $WARNS warning(s)"
  exit "$EX_CHECK"
elif [[ $WARNS -gt 0 ]]; then
  warn "$WARNS warning(s)"
  exit "$EX_OK"
else
  ok "All checks passed"
  exit "$EX_OK"
fi
