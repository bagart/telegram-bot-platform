#!/usr/bin/env bash
# CI-equivalent local gate.
#
# Thin delegation to the primary gate in --ci mode (02-developer-tooling.md §4:
# commands must not duplicate orchestration logic).
#
# Usage:
#   cmd/ci/check [flags accepted by cmd/dev/check]

set -euo pipefail

SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/root.sh"

exec bash "$REPO_ROOT/cmd/dev/check" --ci "$@"
