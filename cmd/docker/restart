#!/usr/bin/env bash
# Restart development stack containers.
#
# Usage:
#   cmd/docker/restart                # restart all dev services
#   cmd/docker/restart php-fpm        # restart specific services

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/root.sh"
source "$REPO_ROOT/cmd/lib/common.sh"
source "$REPO_ROOT/cmd/lib/docker.sh"

require_docker

cd "$REPO_ROOT"
docker compose -f docker-compose.dev.yaml restart "$@"