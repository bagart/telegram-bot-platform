#!/usr/bin/env bash
# Tail development stack logs.
#
# Usage:
#   cmd/docker/logs                  # all services
#   cmd/docker/logs php-fpm          # specific service

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/root.sh"
source "$REPO_ROOT/cmd/lib/common.sh"
source "$REPO_ROOT/cmd/lib/docker.sh"

require_docker

cd "$REPO_ROOT"
docker compose -f docker-compose.dev.yaml logs -f "$@"