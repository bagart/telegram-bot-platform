#!/usr/bin/env bash
# Stop the development stack.
#
# Usage:
#   cmd/docker/down                   # stop containers (normal, keeps volumes)
#   cmd/docker/down -v                # also remove named volumes (destructive)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/root.sh"
source "$REPO_ROOT/cmd/lib/common.sh"
source "$REPO_ROOT/cmd/lib/docker.sh"

require_docker

cd "$REPO_ROOT"
docker compose -f docker-compose.dev.yaml down "$@"